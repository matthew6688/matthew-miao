{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "matthew-miao",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "matthew-miao.com", "custom_domain": true },
    { "pattern": "www.matthew-miao.com", "custom_domain": true }
  ],
  "vars": {
    "SITE_URL": "https://matthew-miao.com",
    "PUBLIC_SITE_URL": "https://matthew-miao.com",
    "ADMIN_EMAIL": "hi@fengtalk.ai",
    "MEDIA_PUBLIC_BASE_URL": "https://matthew-miao.com/media/"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "matthew-miao-next-cache"
    },
    {
      "binding": "MEDIA_R2_BUCKET",
      "bucket_name": "matthew-miao-media"
    }
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "matthew-miao-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "SITE_URL": "https://matthew-miao-staging.matthew6688.workers.dev",
        "PUBLIC_SITE_URL": "https://matthew-miao-staging.matthew6688.workers.dev",
        "ADMIN_EMAIL": "hi@fengtalk.ai",
        "MEDIA_PUBLIC_BASE_URL": "https://matthew-miao-staging.matthew6688.workers.dev/media/"
      },
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "matthew-miao-staging-next-cache"
        },
        {
          "binding": "MEDIA_R2_BUCKET",
          "bucket_name": "matthew-miao-staging-media"
        }
      ],
      "images": { "binding": "IMAGES" }
    },
    "preview": {
      "name": "matthew-miao-preview",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "SITE_URL": "https://matthew-miao-preview.matthew6688.workers.dev",
        "PUBLIC_SITE_URL": "https://matthew-miao-preview.matthew6688.workers.dev",
        "ADMIN_EMAIL": "hi@fengtalk.ai",
        "MEDIA_PUBLIC_BASE_URL": "https://matthew-miao-preview.matthew6688.workers.dev/media/"
      },
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "matthew-miao-staging-next-cache"
        },
        {
          "binding": "MEDIA_R2_BUCKET",
          "bucket_name": "matthew-miao-staging-media"
        }
      ],
      "images": { "binding": "IMAGES" }
    }
  }
}
